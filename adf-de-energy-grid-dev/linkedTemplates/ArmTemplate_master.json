{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-de-energy-grid-dev"
		},
		"ls_KeyVault_deEnergyGrid_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://kv-de-energy-grid-dev.vault.azure.net/"
		},
		"ls_ADLS_deEnergyGrid_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://stdeenergygriddev.dfs.core.windows.net/"
		},
		"ls_ENTSOE_HTTP_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://web-api.tp.entsoe.eu/api"
		},
		"tr_Daily_5AM_UTC_properties_pl_ENTSOE_Ingestion_parameters_targetDate": {
			"type": "string",
			"defaultValue": "@formatDateTime(addDays(trigger().scheduledTime, -1), 'yyyy-MM-dd')"
		},
		"tr_Monthly_Capacity_properties_pl_ENTSOE_Capacity_parameters_targetYear": {
			"type": "string",
			"defaultValue": "@string(year(trigger().scheduledTime))"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-de-energy-grid-dev_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_KeyVault_deEnergyGrid_properties_typeProperties_baseUrl": {
						"value": "[parameters('ls_KeyVault_deEnergyGrid_properties_typeProperties_baseUrl')]"
					},
					"ls_ADLS_deEnergyGrid_properties_typeProperties_url": {
						"value": "[parameters('ls_ADLS_deEnergyGrid_properties_typeProperties_url')]"
					},
					"ls_ENTSOE_HTTP_properties_typeProperties_url": {
						"value": "[parameters('ls_ENTSOE_HTTP_properties_typeProperties_url')]"
					},
					"tr_Daily_5AM_UTC_properties_pl_ENTSOE_Ingestion_parameters_targetDate": {
						"value": "[parameters('tr_Daily_5AM_UTC_properties_pl_ENTSOE_Ingestion_parameters_targetDate')]"
					},
					"tr_Monthly_Capacity_properties_pl_ENTSOE_Capacity_parameters_targetYear": {
						"value": "[parameters('tr_Monthly_Capacity_properties_pl_ENTSOE_Capacity_parameters_targetYear')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}